APP_NAME=OhMyShares
APP_ENV=production
APP_KEY=PUT_YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_MARKETS_CACHE_ENABLED=true

API_ENDPOINT=/api

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL_ERRORS=
LOG_SLACK_WEBHOOK_URL_WARNINGS=

L5_SWAGGER_CONST_HOST=http://localhost:8000/api

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ohmyshares
DB_USERNAME=ohmyshares
DB_PASSWORD=YOUR_DB_PASSWORD
DB_ROOT_PASSWORD=YOUR_DB_ROOT_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

MEMCACHED_PERSISTENT_ID=oms
MEMCACHED_HOST=memcached

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_NOREPLY=noreply@your-domain.com
MAIL_SUPPORT=support@your-domain.com

# If you want to use hCaptcha for signup you may get free credentials from https://hcaptcha.com
H_CAPTCHA_SITE_KEY=
H_CAPTCHA_SECRET=

# Set to "false" to disable user registration (hides signup in UI and rejects signup API requests)
SIGNUP_ENABLED=false

# Links shown on the signup form. Leave empty to hide the link
PRIVACY_POLICY_URL=https://ohmyshares.com/privacy
USER_AGREEMENT_URL=https://ohmyshares.com/terms

# Plugin store: any public GitHub repo tagged with this topic is listed automatically.
# Optional token raises GitHub API rate limits. Extra registries: comma-separated URLs to registry.json files.
PLUGINS_GITHUB_TOPIC=ohmyshares-plugin
PLUGINS_GITHUB_TOKEN=
PLUGINS_REGISTRIES=

L5_SWAGGER_GENERATE_ALWAYS=true

# API documentation access http://localhost:8000/api/documentation
BASIC_AUTH_ENABLED=true
BASIC_AUTH_USERNAME=oms
BASIC_AUTH_PASSWORD=YOUR_API_DOC_PASSWORD
